# bb-sentinel — never commit user-specific config or runtime state
config/programs.yaml
config/global.yaml
config/*.inscope
config/*.scope
config/*.rules.txt
!config/example-program.scope

# Engagement-specific helper scripts (per-program target curation)
scripts/six_*.py
.env
.env.*
!.env.example

